    "build-distribution",
    "fastlane",
    "flutter",
    "react-native"
  ],
  "homepage": "https://appdropper.io/help/ci-cd-uploads",
  "bugs": {
    "url": "https://appdropper.io/contact"
  },
  "license": "MIT",
